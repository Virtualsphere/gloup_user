  "cards": [
    {
      "dot": "emerald",
      "title": "Happy path",
      "items": [
        "OrderBloc: CreateOrderEvent, then VerifyPaymentEvent",
        "paymentsuccess verifies the signature; Bookings reloads"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure + cancel",
      "items": [
        "PaymentFailedEvent or leaving the page cancels the order",
        "Unpaid bookings also expire after 5 minutes"
