{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "GloUp Booking + Payment Sequence",
    "output": "user-booking-sequence.html",
    "viewBox": [
      1080,
      591
    ],
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "create-order",
        "label": "Create order",
        "focus": [
          "user",
          "confirm",
          "backend",
          "razorpay"
        ],
        "note": "Pay now creates a pending appointment and a server-side Razorpay order."
      },
      {
        "id": "pay-and-verify",
        "label": "Pay and verify",
        "focus": [
          "confirm",
          "backend",
          "razorpay",
          "bookings"
        ],
        "note": "Checkout returns a signed payment that the backend verifies before the user lands on Bookings."
      },
      {
        "id": "failure-and-cancel",
        "label": "Failure and cancel",
        "focus": [
          "user",
          "confirm",
          "backend",
          "razorpay"
        ],
        "note": "A failed or dismissed checkout cancels the pending order and releases the slot."
      }
    ]
  },
  "participants": [
    {
      "id": "user",
      "type": "external",
      "label": "User",
      "sublabel": "customer"
    },
    {
      "id": "confirm",
      "type": "frontend",
      "label": "BookingConfirmation",
      "sublabel": "page + OrderBloc"
    },
    {
      "id": "backend",
      "type": "backend",
      "label": "GloUp API",
      "sublabel": "/user/app/v2"
    },
    {
      "id": "razorpay",
      "type": "external",
      "label": "Razorpay",
      "sublabel": "orders + checkout"
    },
    {
      "id": "bookings",
      "type": "frontend",
      "label": "Bookings",
      "sublabel": "appointments tab"
    }
  ],
  "segments": [
    {
      "from": 153,
      "to": 232,
      "label": "Create order"
    },
    {
      "from": 237,
      "to": 316,
